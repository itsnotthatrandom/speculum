{
  "manifest_version": 3,
  "name": "Speculum",
  "version": "1.1",
  "description": "Mirror the outgoing webcam stream in Google Meet.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toggle Speculum mirroring" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["mirror.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
